{
  "name": "attegi",
  "type": "module",
  "description": "Attegi is an elegant and dynamic Ghost theme, with a modern design, deep support for Ghost, and specially optimized for mobile devices.",
  "demo": "https://attegi.tuuhub.com",
  "version": "6.12.3",
  "engines": {
    "ghost": ">=5.118.0"
  },
  "packageManager": "pnpm@12.16.1",
  "license": "AGPL-3.0-only",
  "screenshots": {
    "desktop": "screenshots/homepage-dark.png",
    "mobile": "screenshots/iphone.png"
  },
  "author": {
    "name": "bunizao",
    "email": "me@tutuis.me",
    "url": "https://tutuis.me"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Minimal",
      "Personal Blogs"
    ]
  },
  "keywords": [
    "ghost-theme",
    "ghost",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bunizao/Attegi.git"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:hot": "node scripts/dev.ts hot",
    "dev:preview": "node scripts/dev.ts preview",
    "serve:hot": "node scripts/dev-hot.ts",
    "serve:preview": "node scripts/dev-preview.ts",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc",
    "compress": "pnpm run build && node scripts/compress.ts",
    "clean": "rm -rf assets/js/*.js assets/css/style.css assets/css/style.css.map dist/",
    "test:templates": "node --test scripts/tests",
    "validate": "pnpm run typecheck && pnpm run test:templates && pnpm run compress && pnpm dlx gscan -z dist/attegi.zip"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/browser-sync": "^2.29.1",
    "@types/node": "^26.6.6",
    "archiver": "^8.0.0",
    "browser-sync": "^3.0.4",
    "tocbot": "^4.36.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "config": {
    "posts_per_page": 8,
    "image_sizes": {
      "s": {
        "width": 320
      },
      "m": {
        "width": 640
      },
      "l": {
        "width": 960
      },
      "xl": {
        "width": 1920
      }
    },
    "card_assets": true,
    "custom": {
      "color_scheme": {
        "type": "select",
        "options": [
          "Light",
          "Dark",
          "System"
        ],
        "default": "System"
      },
      "darkmode_accent_color": {
        "type": "color",
        "default": "#82C0CC"
      },
      "instagram_url": {
        "type": "text",
        "description": "Social media links displayed in the page footer."
      },
      "github_url": {
        "type": "text"
      },
      "telegram_url": {
        "type": "text"
      },
      "discord_url": {
        "type": "text"
      },
      "bluesky_url": {
        "type": "text"
      },
      "email_address": {
        "type": "text"
      },
      "footer_text": {
        "type": "text",
        "description": "Custom text displayed in footer center. HTML snippets can be inserted."
      },
      "og_service_url": {
        "type": "text",
        "description": "Optional OG image service base URL. Leave empty to use Ghost defaults."
      },
      "og_service_theme": {
        "type": "text",
        "description": "Optional theme name for the OG image service."
      },
      "email_signup_text": {
        "type": "text",
        "default": "Sign up for more like this.",
        "group": "post"
      },
      "show_recent_posts_footer": {
        "type": "boolean",
        "default": true,
        "group": "post"
      },
      "post_share": {
        "type": "select",
        "options": [
          "Default",
          "Native",
          "Disabled"
        ],
        "default": "Default",
        "group": "post"
      },
      "disqus_shortname": {
        "type": "text",
        "default": "",
        "group": "post"
      }
    }
  },
  "browserslist": [
    "defaults",
    "safari >= 16",
    "ios_saf >= 16"
  ],
  "dependencies": {
    "handlebars": "^4.7.10"
  }
}
